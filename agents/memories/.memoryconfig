version: "1.0"

# Storage configuration
storage:
  root: "./agents/memories"
  entities_path: "entities"
  index_path: "index"
  schemas_path: "schemas"

# Indexing configuration
indexing:
  # Embedding model for semantic search
  # Options: "text-embedding-3-small", "text-embedding-3-large", "text-embedding-ada-002"
  embedding_model: "text-embedding-3-small"

  # Chunk size in tokens for embedding
  chunk_size: 512

  # Overlap between chunks
  overlap: 50

  # Minimum similarity threshold for semantic search results
  min_similarity: 0.7

  # Rebuild index on startup
  rebuild_on_start: false

# Search configuration
search:
  # Maximum number of results to return
  max_results: 10

  # Default depth for graph traversal
  default_depth: 2

  # Include metadata in search results
  include_metadata: true

  # Highlight matching text
  highlight_matches: true

  # Enable fuzzy matching for text search
  fuzzy_matching: true

  # Minimum match score for fuzzy matching
  fuzzy_threshold: 0.8

# Git integration
git:
  # Automatically commit memory changes
  auto_commit: false

  # Commit message template
  # Available variables: {operation}, {entity_type}, {entity_name}, {author}
  commit_message_template: "Memory: {operation} {entity_type}/{entity_name}"

  # Automatically push commits
  auto_push: false

  # Branch to use for memory updates
  branch: "main"

# Memory pruning and maintenance
pruning:
  # Enable automatic pruning
  enabled: false

  # Maximum age in days before archiving
  max_age_days: 365

  # Minimum number of references to keep an entity
  min_references: 2

  # Path for archived entities
  archive_path: "archive"

  # Remove orphaned entities (no relations)
  remove_orphans: false

# Privacy and security
privacy:
  # Enable encryption for sensitive entities
  encryption_enabled: false

  # Entities to exclude from version control (in .gitignore)
  exclude_patterns:
    - "**/sensitive-*"
    - "**/*-private.*"

  # Require manual review before committing
  require_review: true

# Performance
performance:
  # Cache size for embeddings (number of entities)
  cache_size: 1000

  # Enable parallel processing for indexing
  parallel_indexing: true

  # Number of worker threads
  worker_threads: 4

# Validation
validation:
  # Enable JSON schema validation
  schema_validation: true

  # Fail on validation errors
  strict_mode: false

  # Validate on read operations
  validate_on_read: false

  # Validate on write operations
  validate_on_write: true

# Logging
logging:
  # Log level: DEBUG, INFO, WARNING, ERROR
  level: "INFO"

  # Log memory operations
  log_operations: true

  # Log file path (relative to memory root)
  log_file: "memory.log"

  # Maximum log file size in MB
  max_log_size: 10

  # Number of log files to keep
  log_backup_count: 5
