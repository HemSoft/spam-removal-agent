{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://relias.com/schemas/memory/entity.json",
  "version": "1.0.0",
  "title": "Memory Entity",
  "description": "Schema for memory entity metadata",
  "type": "object",
  "required": ["title", "type", "permalink", "created", "updated"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Human-readable title of the entity"
    },
    "type": {
      "type": "string",
      "enum": ["project", "person", "decision", "concept", "issue", "resource", "meeting", "task"],
      "description": "Category of the entity"
    },
    "permalink": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique URL-safe identifier in kebab-case"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of entity creation"
    },
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true,
      "description": "Tags for categorization and discovery"
    },
    "author": {
      "type": "string",
      "description": "Person or agent who created the entity"
    },
    "status": {
      "type": "string",
      "enum": ["active", "archived", "deprecated"],
      "default": "active",
      "description": "Current status of the entity"
    }
  },
  "additionalProperties": true
}
