{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://relias.com/schemas/memory/relation.json",
  "version": "1.0.0",
  "title": "Memory Relation",
  "description": "Schema for relations between entities",
  "type": "object",
  "required": ["type", "target"],
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "description": "Relation type in snake_case (e.g., depends_on, relates_to)"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Permalink of the target entity"
    },
    "context": {
      "type": "string",
      "maxLength": 200,
      "description": "Additional context about the relation"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of relation creation"
    },
    "strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Strength or importance of the relation (0-1)"
    },
    "bidirectional": {
      "type": "boolean",
      "default": false,
      "description": "Whether this relation should be considered bidirectional"
    }
  },
  "additionalProperties": false
}
