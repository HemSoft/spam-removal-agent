{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://relias.com/schemas/memory/observation.json",
  "version": "1.0.0",
  "title": "Memory Observation",
  "description": "Schema for observations (facts) attached to entities",
  "type": "object",
  "required": ["category", "content", "created"],
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "fact",
        "decision",
        "preference",
        "constraint",
        "tip",
        "issue",
        "resource",
        "question",
        "experiment",
        "note"
      ],
      "description": "Type of observation"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "The observation content"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true,
      "description": "Tags relevant to this observation"
    },
    "context": {
      "type": "string",
      "maxLength": 200,
      "description": "Additional context or source information"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of observation creation"
    },
    "author": {
      "type": "string",
      "description": "Person or agent who created the observation"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence level in this observation (0-1)"
    }
  },
  "additionalProperties": false
}
